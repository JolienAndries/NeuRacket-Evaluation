#lang racket

;; eentje voor 1 in 1 out ; 1 in 3 out ; 3 in 1 out maken en dan kijken maar ik vrees ervoor want het is met syntax

(require "neuracket-classes.rkt" "neuracket-neural-slices.rkt")
(provide run-neuracket-inter-object-assign-benchmarks)

(define (run-neuracket-inter-object-assign-benchmarks iter times)
  (assign-x-in-1-out iter times)
  (assign-1-in-x-out iter times))

(define (assign-x-in-1-out iter times)
  (define (do-assign obj iter)
    (do ((i 0 (+ i 1)))
      ((>= i iter))
      (set-field! lbl1 obj 42)))
  
  (for-each (lambda (neural-slice objs-in)
              (let ((obj-out (new inter-object-class%)))
                (apply new-neural-slice neural-slice (append objs-in (list obj-out)))
                (displayln (list "----- " (length objs-in) " in 1 out -----"))
                (do ((i 0 (+ i 1))) ;; do benchmark times
                  ((>= i times))
                  (displayln (time (do-assign obj-out iter))))))
            (list 1-in-1-out-slice 3-in-1-out-slice 5-in-1-out-slice 7-in-1-out-slice
                  9-in-1-out-slice 11-in-1-out-slice 13-in-1-out-slice 15-in-1-out-slice
                  17-in-1-out-slice 19-in-1-out-slice)
            (build-list 10 (lambda (n)
                             (build-list (+ (* 2 n) 1) (lambda (_) (new inter-object-class%)))))))

(define (assign-1-in-x-out iter times)
  (for-each (lambda (title bm)
              (displayln title)
              (do ((i 0 (+ i 1))) ;; do benchmark 10 times 
                ((>= i times))
                (bm iter)))
            (build-list 9 (lambda (n) (list "----- 1 in " (+ (* 2 n) 3) " out -----")))
            (list assign-1-in-3-out assign-1-in-5-out assign-1-in-7-out assign-1-in-9-out
                  assign-1-in-11-out assign-1-in-13-out assign-1-in-15-out assign-1-in-17-out
                  assign-1-in-19-out)))

(define (assign-1-in-3-out iter)
  (let ((obj-in (new inter-object-class%))
        (obj-out1 (new inter-object-class%))
        (obj-out2 (new inter-object-class%))
        (obj-out3 (new inter-object-class%)))
    (displayln "A")
    (new-neural-slice 1-in-3-out-slice obj-in obj-out1 obj-out2 obj-out3)
    (displayln "B")
    (displayln (time (do ((i 0 (+ i 1)))
                       ((>= i iter))
                       (displayln "C")
                       (set-fields! (lbl1 lbl2 lbl3) (obj-out1 obj-out2 obj-out3) (1 2 3)))))))

