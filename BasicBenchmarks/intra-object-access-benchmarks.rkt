;; general 
(define (do-benchmark-x-times x times obj benchmark title)
  (displayln title)
  (do ((i 0 (+ i 1)))
    ((>= i times))
    (displayln (time (benchmark obj x)))))

(define (run-access-benchmark x times object-1-out object-1-in)
  (for-each (lambda (b title) (do-benchmark-x-times x times object-1-out b title))
            (list benchmark-access-1-in-1-out benchmark-access-3-in-1-out benchmark-access-5-in-1-out benchmark-access-7-in-1-out benchmark-access-9-in-1-out benchmark-access-11-in-1-out benchmark-access-13-in-1-out benchmark-access-15-in-1-out benchmark-access-17-in-1-out benchmark-access-19-in-1-out)
            (build-list 10 (lambda (n) (list "-----" (+ (* 2 n) 1) "in 1 out -----"))))
  (for-each (lambda (b title) (do-benchmark-x-times x times object-1-in b title))
            (list benchmark-access-1-in-3-out benchmark-access-1-in-5-out benchmark-access-1-in-7-out benchmark-access-1-in-9-out benchmark-access-1-in-11-out benchmark-access-1-in-13-out benchmark-access-1-in-15-out benchmark-access-1-in-17-out benchmark-access-1-in-19-out)
            (build-list 9 (lambda (n) (list "----- 1 in " (+ (* 2 n) 3) "out -----")))))

       
